GEMINI_API_KEY=your_gemini_api_key_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# Secret used to sign login session (JWT) tokens. Set this to any long random
# string for persistent sessions across backend restarts. If left unset, a
# random one is generated per process start (all sessions invalidate on restart).
JWT_SECRET_KEY=change_this_to_a_long_random_string

# Email OTP (SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_sender_email@gmail.com